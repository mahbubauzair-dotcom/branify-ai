# VectorEngine Gateway Configuration (Server-Side Only - Never Exposed to Browser)
VECTOR_ENGINE_API_KEY=
VECTOR_ENGINE_BASE_URL="https://api.vectorengine.ai"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Places / Maps API (Server-Side Only for Lead Discovery)
GOOGLE_PLACES_API_KEY=

# Supabase Configuration for Private Single-Owner Storage & Authentication
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Private Owner Authentication Secret (Required for Single-Owner Login)
# Set your master owner password in Google AI Studio Settings -> Secrets or server env.
BRANIFY_OWNER_PASSWORD=
