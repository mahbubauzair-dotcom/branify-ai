# VectorEngine Gateway Configuration (Server-Side Only - Never Exposed to Browser)
VECTOR_ENGINE_API_KEY=
VECTOR_ENGINE_BASE_URL="https://api.vectorengine.ai"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Places / Maps API (Server-Side Only for Lead Discovery)
GOOGLE_PLACES_API_KEY=

# Supabase Configuration for Private Single-Owner Storage & Authentication
# These are the BROWSER-SAFE publishable values — safe to expose in the frontend.
# The secret/service-role key must NEVER be committed or used in frontend code.
# Format: https://<project-ref>.supabase.co + sb_publishable_...
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# (Optional) Separate Supabase for the Afroza/Royal Crown template demos.
# If not set, the templates run in local demo mode (no Supabase needed).
# Useful when a deployed salon site needs its OWN isolated database.
VITE_AFROZA_SUPABASE_URL=
VITE_AFROZA_SUPABASE_KEY=

# Private Owner Authentication Secret (Required for Single-Owner Login)
# Set your master owner password in Vercel env vars or server env.
BRANIFY_OWNER_PASSWORD=
